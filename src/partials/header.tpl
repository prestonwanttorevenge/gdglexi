<header id="site-header" class="site-header">
  <div class="container header-inner">
    <a href="#top" class="brand" aria-label="GDGLexi - Trang chủ">
      <span class="brand__mark" aria-hidden="true">
        <svg viewBox="0 0 36 24" width="34" height="22" fill="none">
          <path d="M12.5 5.5 4.5 12l8 6.5" stroke="#4285F4" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
          <path d="M12.5 5.5 7.5 9.5" stroke="#EA4335" stroke-width="3" stroke-linecap="round" />
          <path d="M23.5 5.5 31.5 12l-8 6.5" stroke="#34A853" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
          <path d="M23.5 18.5 28.5 14.5" stroke="#FBBC04" stroke-width="3" stroke-linecap="round" />
        </svg>
      </span>
      <span class="brand__text">
        <span class="brand__name">GDGLexi</span>
        <span class="brand__sub">GDG on Campus - DUT</span>
      </span>
    </a>

    <nav class="main-nav" aria-label="Điều hướng chính">
      <a href="#courses" class="nav-link">Khóa học</a>
      <a href="#methodology" class="nav-link">Phương pháp</a>
      <a href="#testimonials" class="nav-link">Học viên</a>
      <a href="#faq" class="nav-link">Hỏi đáp</a>
    </nav>

    <div class="header-actions">
      <button
        type="button"
        class="icon-btn theme-toggle"
        data-theme-toggle
        aria-pressed="false"
        aria-label="Chuyển sang giao diện tối"
        title="Đổi chế độ Sáng / Tối"
      >
        <svg class="icon-sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" />
        </svg>
        <svg class="icon-moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
        </svg>
      </button>

      <button
        type="button"
        id="wishlist-open-btn"
        class="icon-btn wishlist-trigger"
        aria-label="Mở danh sách khóa học quan tâm"
        title="Khóa học đã lưu"
      >
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z" />
        </svg>
        <span id="wishlist-count" class="wishlist-badge" hidden>0</span>
      </button>

      <a href="#contact" class="btn btn--primary btn--sm header-cta">Kiểm tra trình độ</a>

      <button
        type="button"
        id="mobile-menu-toggle"
        class="icon-btn mobile-menu-btn"
        aria-expanded="false"
        aria-controls="mobile-drawer"
        aria-label="Mở menu điều hướng"
      >
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true">
          <line x1="3" y1="6" x2="21" y2="6" />
          <line x1="3" y1="12" x2="21" y2="12" />
          <line x1="3" y1="18" x2="21" y2="18" />
        </svg>
      </button>
    </div>
  </div>
</header>
